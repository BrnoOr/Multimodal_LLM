# Copiar a .env (no se versiona). launch.sh lo carga automáticamente.
# Cachés fuera de / (el disco raíz del cluster está ajustado)
HF_HOME=/mnt/home2/t7-vLLM/.cache/hf
UV_CACHE_DIR=/mnt/home2/t7-vLLM/.cache/uv

# Token de Hugging Face: requerido por VL-JEPA (Llama-3.2-1B y EmbeddingGemma son modelos con licencia aceptada)
HF_TOKEN=

# Datos (por defecto: data/raw/m3di)
# M3DI_ROOT=/mnt/home2/t7-vLLM/data/m3di

# GPU por defecto en el cluster (la 0 la ocupa otro usuario)
GPU=1
# Umbral (MiB) de memoria ya usada sobre el cual launch.sh considera la GPU ocupada
GPU_MAX_USED_MB=1024
